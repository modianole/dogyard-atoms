# ============================================================
# DogYard Atoms — Environment Contract
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# Variable categories:
#   REQUIRED   — the app will not start / function without these.
#   OPTIONAL   — feature is disabled or degraded if omitted.
#   BUILD-TIME — baked into the static bundle at docker build time (VITE_*).
#                They are NOT secret-safe. Do NOT put private keys here.
#
# Secrets management in production (cloud):
#   All build-time values are passed as Docker build ARGs and must be supplied
#   via your CI/CD secret store (GitHub Actions: Settings → Secrets → Actions).
#   They are NOT stored in the image metadata.
#   Runtime secrets (e.g. database passwords, signing keys) must be injected
#   via K8s Secrets / ExternalSecrets and never baked into the image.
# ============================================================

# ------------------------------------------------------------
# Supabase — REQUIRED
# ------------------------------------------------------------
# Project URL from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Publishable (public) key — safe to embed in the browser bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anonymous (public) key — used by the Supabase JS client for RLS-protected queries.
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Internal project ID (used by edge function URLs etc).
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# ------------------------------------------------------------
# Google Maps — REQUIRED for map features
# ------------------------------------------------------------
# Restrict this key to your domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=AIza...

# ------------------------------------------------------------
# Admin access — OPTIONAL (admin pages are locked without these)
# ------------------------------------------------------------
# The Supabase auth UUID of the single owner account that may access /admin.
VITE_ADMIN_USER_ID=

# The email address matching VITE_ADMIN_USER_ID (defense-in-depth check).
VITE_ADMIN_EMAIL=
