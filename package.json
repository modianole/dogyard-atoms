{
  "name": "dogyard-atoms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docker:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/docker-reset-and-run.ps1 -Services app,app-2",
    "docker:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/docker-reset-and-run.ps1 -Services app,app-2 -Watch",
    "play": "npx cap sync android && npx cap run android",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "figma:check": "powershell -ExecutionPolicy Bypass -File ./scripts/figma-mcp-check.ps1",
    "figma:mcp": "npx ai-figma-mcp@latest",
    "figma:mcp:local": "npm --prefix ./mcp-figma run start",
    "figma:setup:local": "npm --prefix ./mcp-figma run setup",
    "verify:android:firebase": "node ./scripts/verify-android-firebase.mjs",
    "qa:routes": "node ./scripts/qa-launch-routes.mjs"
  },
